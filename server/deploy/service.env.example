# Real file: /etc/ottai-cloud/service.env, root:root 0600. Never commit real tokens.
DATABASE_PATH=/var/lib/ottai-cloud/glucose.sqlite3
BIND_HOST=127.0.0.1
BIND_PORT=18776
INGEST_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_PLUS_CHARACTER_TOKEN
READ_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_32_PLUS_CHARACTER_TOKEN
# Optional separate capability for a host that may request manual analysis. Never provision to Widget.
ANALYZE_TOKEN=REPLACE_WITH_A_THIRD_SEPARATE_32_PLUS_CHARACTER_TOKEN

# Enable only after the intended adult's data use and scientific method are configured.
ANALYSIS_ENABLED=false
OPENAI_RELAY_URL=http://127.0.0.1:18779
OPENAI_RELAY_SERVICE_ID=ottai
OPENAI_RELAY_CLIENT_SECRET=REPLACE_WITH_THE_PRIVATE_RELAY_CLIENT_SECRET
OPENAI_MODEL=gpt-6.1-terra

# Optional dedicated food-photo service. Separate quota/credentials; no provider key on Ali.
FOOD_OPENAI_RELAY_URL=http://127.0.0.1:18781
FOOD_OPENAI_RELAY_SERVICE_ID=ottai-food
FOOD_OPENAI_RELAY_CLIENT_SECRET=REPLACE_WITH_SEPARATE_PRIVATE_FOOD_RELAY_SECRET
FOOD_OPENAI_MODEL=gpt-6.1-terra
