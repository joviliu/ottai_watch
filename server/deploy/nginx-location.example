# Larger body allowance applies only to the authenticated activity endpoint.
# Preserve the deployment's existing validated TLS server and route ownership.
location = /ottai/api/v1/activity {
    client_max_body_size 4m;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 15s;
    proxy_pass http://127.0.0.1:18776/api/v1/activity;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    access_log off;
}

# Explicit authenticated photo requests are async; raw JPEG bytes stay in worker RAM.
location = /ottai/api/v1/meals/recognize {
    client_max_body_size 1500k;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 15s;
    proxy_pass http://127.0.0.1:18776/api/v1/meals/recognize;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    access_log off;
}

# Include within the already validated TLS server, preserving its certificate and other routes.
location /ottai/ {
    client_max_body_size 256k;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 15s;
    proxy_pass http://127.0.0.1:18776/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    access_log off;
}
