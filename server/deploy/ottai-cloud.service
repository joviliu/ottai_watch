[Unit]
Description=Private Ottai readings API
After=network.target

[Service]
Type=simple
User=ottai-cloud
Group=ottai-cloud
WorkingDirectory=/srv/ottai-cloud/app
EnvironmentFile=/etc/ottai-cloud/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m server.app serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ottai-cloud
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
CPUQuota=50%
TasksMax=64
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
