[Unit]
Description=Daily Ottai observational report
After=network-online.target ottai-cloud.service
Wants=network-online.target

[Service]
Type=oneshot
User=ottai-cloud
Group=ottai-cloud
WorkingDirectory=/srv/ottai-cloud/app
EnvironmentFile=/etc/ottai-cloud/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m server.app run-daily
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ottai-cloud
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
CPUQuota=50%
TasksMax=32
TimeoutStartSec=180
