# Use absolute paths to your installed toolchain; source this file after editing.
export JDK=/absolute/path/to/jdk
export ANDROID_JAR=/absolute/path/to/android-sdk/platforms/android-35/android.jar
export FRAMEWORK_RES=/absolute/path/to/android-sdk/platforms/android-35/android.jar
export AIDL=/absolute/path/to/android-sdk/build-tools/35.0.0/aidl
export AAPT2=/absolute/path/to/android-sdk/build-tools/35.0.0/aapt2
export D8_JAR=/absolute/path/to/android-sdk/build-tools/35.0.0/lib/d8.jar
export APKSIG_JAR=/absolute/path/to/apksig.jar
